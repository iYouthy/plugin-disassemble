[configuration]

entry_symbol = "gdscript_disassemble_library_init"
; The bytecode reader depends on the engine's C++ struct layout, so it only
; claims support for the engine it was built and verified against.
compatibility_minimum = "4.7.2"
reloadable = false

[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.

; macOS -- built with `scons arch=arm64`
macos.debug.arm64 = "./macos/libgdscript-disassemble.macos.template_debug.arm64.dylib"
macos.release.arm64 = "./macos/libgdscript-disassemble.macos.template_release.arm64.dylib"
; macOS -- built with the default universal arch
macos.debug = "./macos/libgdscript-disassemble.macos.template_debug.universal.dylib"
macos.release = "./macos/libgdscript-disassemble.macos.template_release.universal.dylib"

; Linux
linux.x86_64.debug = "./linux/libgdscript-disassemble.linux.template_debug.x86_64.so"
linux.x86_64.release = "./linux/libgdscript-disassemble.linux.template_release.x86_64.so"
linux.arm64.debug = "./linux/libgdscript-disassemble.linux.template_debug.arm64.so"
linux.arm64.release = "./linux/libgdscript-disassemble.linux.template_release.arm64.so"

; Windows
windows.x86_64.debug = "./windows/gdscript-disassemble.windows.template_debug.x86_64.dll"
windows.x86_64.release = "./windows/gdscript-disassemble.windows.template_release.x86_64.dll"
